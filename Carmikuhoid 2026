</section>

<script>
// Keele vahetus
function setLanguage(lang) {
  document.querySelectorAll("[data-et]").forEach(el => {
    el.textContent = el.getAttribute("data-" + lang);
  });
}

// Broneeringu vorm ja konfetti efekt
document.getElementById("bookingForm").addEventListener("submit", function(e){
  e.preventDefault();
  // Näita õnnestus
  const successMsg = document.querySelector(".success-message");
  successMsg.style.display = "block";
  // Konfeti efekt
  const confettiContainer = document.getElementById("confetti");
  for(let i=0;i<100;i++){
    let div = document.createElement("div");
    div.classList.add("confetti-piece");
    div.style.background = ['#ff0000','#00ff00','#0000ff','#ff9900','#ff00ff'][Math.floor(Math.random()*5)];
    div.style.left = Math.random()*window.innerWidth + 'px';
    confettiContainer.appendChild(div);
    setTimeout(()=>{div.remove();},3000);
  }
  // Reset form
  this.reset();
});
</script>

</body>
</html>
