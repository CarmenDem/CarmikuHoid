<!DOCTYPE html>
<html lang="et">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Carmikuhoid – Lemmikuhoidja Carmen</title>
  <style>
    body { font-family: Arial, sans-serif; margin:0; padding:0; background:#f8f8f8; color:#333; }
    header { background:#ffcc00; padding:30px; text-align:center; }
    header h1 { margin:0; font-size:2em; }
    nav { display:flex; justify-content:center; background:#ffc; }
    nav a { margin:10px 15px; text-decoration:none; color:#333; font-weight:bold; }
    section { padding:20px; margin:20px auto; max-width:900px; background:#fff; border-radius:10px; box-shadow:0 0 15px rgba(0,0,0,0.1); }
    h2 { color:#ff9900; }
    ul { list-style:none; padding:0; }
    li { margin-bottom:10px; }
    input, textarea, select, button { display:block; width:100%; padding:10px; margin:10px 0; border-radius:5px; border:1px solid #ccc; }
    button { background:#ff9900; color:white; font-weight:bold; border:none; cursor:pointer; }
    button:hover { background:#ff7700; }
    .language-buttons { text-align:right; margin:10px 20px; }
    .language-buttons button { width:auto; display:inline-block; margin-left:5px; }
    .success-message { display:none; color:green; font-weight:bold; }
    /* Confetti effect */
    .confetti { position:fixed; top:0; left:0; width:100%; height:0; pointer-events:none; z-index:9999; overflow:visible; }
    .confetti-piece { position:absolute; width:10px; height:10px; background:red; opacity:0.7; animation:fall 3s linear forwards; }
    @keyframes fall { 0% {transform:translateY(0);} 100% {transform:translateY(500px);opacity:0;} }
  </style>
</head>
<body>

<header>
  <h1 data-et="Lemmikuhoidja Carmen" data-en="Pet Care by Carmen">Lemmikuhoidja Carmen</h1>
  <div class="language-buttons">
    <button onclick="setLanguage('et')">ET</button>
    <button onclick="setLanguage('en')">EN</button>
  </div>
</header>

<nav>
  <a href="#about" data-et="Tutvustus" data-en="About">Tutvustus</a>
  <a href="#services" data-et="Teenused" data-en="Services">Teenused</a>
  <a href="#contact" data-et="Kontakt" data-en="Contact">Kontakt</a>
  <a href="#faq" data-et="KKK" data-en="FAQ">KKK</a>
  <a href="#feedback" data-et="Tagasiside" data-en="Feedback">Tagasiside</a>
</nav>

<section id="about">
  <h2 data-et="Tutvustus" data-en="About">Tutvustus</h2>
